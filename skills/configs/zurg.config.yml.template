zurg: v1
provider: alldebrid
token: ${ALLDEBRID_API_KEY}
check_for_changes_every_secs: 10
enable_repair: true
auto_delete_rar_torrents: true
directories:
  shows:
    group: media
    filters:
      - has_episodes: true
  movies:
    group: media
    only_show_the_biggest_file: true
    filters:
      - regex: /.*/
