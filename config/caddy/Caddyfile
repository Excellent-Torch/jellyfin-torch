# Caddy reverse-proxy configuration for Jellyfin Torch
# Place this file at /etc/caddy/Caddyfile (or wherever your Caddy installation
# loads its config) if you are running Caddy directly on the host.
# If you prefer nginx, see config/nginx/media-stack-locations.conf.

megabinge.org {
	encode gzip

	# Jellyfin
	handle_path /jellyfin/* {
		reverse_proxy 127.0.0.1:8096
	}

	# Sonarr
	handle_path /sonarr/* {
		reverse_proxy 127.0.0.1:8989
	}

	# Radarr
	handle_path /radarr/* {
		reverse_proxy 127.0.0.1:7878
	}

	# Prowlarr
	handle_path /prowlarr/* {
		reverse_proxy 127.0.0.1:9696
	}

	# Overseerr
	handle_path /overseerr/* {
		reverse_proxy 127.0.0.1:5055
	}

	# Decypharr
	handle_path /decypharr/* {
		reverse_proxy 127.0.0.1:8282
	}
}
