# Jellyfin Torch environment secrets
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# AllDebrid API key used by zurg and decypharr
ALLDEBRID_API_KEY=your_alldebrid_api_key_here

# Host user/group IDs for volume ownership
PUID=1000
PGID=1000

# Published Jellyfin URL (used for discovery and reverse-proxy redirects)
JELLYFIN_PUBLISHED_URL=https://megabinge.org/jellyfin

# Timezone for *arr services
TZ=Etc/UTC
